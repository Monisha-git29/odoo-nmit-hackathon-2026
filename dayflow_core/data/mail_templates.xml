<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Correction Approved Template -->
        <record id="email_template_attendance_correction_approved" model="mail.template">
            <field name="name">Attendance Correction: Approved</field>
            <field name="model_id" ref="dayflow_core.model_dayflow_attendance_correction"/>
            <field name="subject">Attendance Correction Approved - {{ object.attendance_date }}</field>
            <field name="email_to">{{ object.employee_id.work_email or object.employee_id.user_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.employee_id.name"/>,<br/><br/>
                        Your attendance correction request for <strong><t t-out="object.attendance_date"/></strong> has been <strong>APPROVED</strong> by HR.<br/>
                        Details:<br/>
                        - Issue Type: <t t-out="object.issue_type"/><br/>
                        - Requested Check-In: <t t-out="object.requested_check_in"/><br/>
                        - Requested Check-Out: <t t-out="object.requested_check_out"/><br/><br/>
                        Your attendance record has been updated accordingly.<br/><br/>
                        Best regards,<br/>
                        HR Team
                    </p>
                </div>
            </field>
        </record>

        <!-- Correction Rejected Template -->
        <record id="email_template_attendance_correction_rejected" model="mail.template">
            <field name="name">Attendance Correction: Rejected</field>
            <field name="model_id" ref="dayflow_core.model_dayflow_attendance_correction"/>
            <field name="subject">Attendance Correction Rejected - {{ object.attendance_date }}</field>
            <field name="email_to">{{ object.employee_id.work_email or object.employee_id.user_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.employee_id.name"/>,<br/><br/>
                        Your attendance correction request for <strong><t t-out="object.attendance_date"/></strong> has been <strong>REJECTED</strong> by HR.<br/><br/>
                        <strong>HR Remark:</strong> <t t-out="object.hr_comment or 'No remark provided.'"/><br/><br/>
                        Best regards,<br/>
                        HR Team
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
