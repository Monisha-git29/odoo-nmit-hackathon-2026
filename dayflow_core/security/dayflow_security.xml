<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Dayflow Category -->
        <record id="module_category_dayflow" model="ir.module.category">
            <field name="name">Dayflow HRMS</field>
            <field name="description">Access levels for Dayflow HRMS</field>
            <field name="sequence">20</field>
        </record>

        <!-- Employee Group -->
        <record id="group_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- HR Officer Group -->
        <record id="group_hr_officer" model="res.groups">
            <field name="name">HR Officer</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('group_employee')), (4, ref('hr.group_hr_user'))]"/>
        </record>

        <!-- Admin Group -->
        <record id="group_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_officer')), (4, ref('hr.group_hr_manager'))]"/>
        </record>

        <!-- Record Rules -->
        <!-- Attendance Correction: Employee can see/modify only their own pending requests -->
        <record id="rule_attendance_correction_employee" model="ir.rule">
            <field name="name">Employee own attendance correction</field>
            <field name="model_id" ref="model_dayflow_attendance_correction"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Attendance Correction: HR and Admin can see and manage all corrections -->
        <record id="rule_attendance_correction_hr" model="ir.rule">
            <field name="name">HR global attendance correction</field>
            <field name="model_id" ref="model_dayflow_attendance_correction"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_officer'))]"/>
        </record>

        <!-- Employee Document: Employee can see/upload only their own documents -->
        <record id="rule_employee_document_employee" model="ir.rule">
            <field name="name">Employee own documents</field>
            <field name="model_id" ref="model_dayflow_employee_document"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Employee Document: HR and Admin can see and manage all documents -->
        <record id="rule_employee_document_hr" model="ir.rule">
            <field name="name">HR global documents</field>
            <field name="model_id" ref="model_dayflow_employee_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_officer'))]"/>
        </record>

        <!-- Salary Contract: Employee Read-only own contract -->
        <record id="rule_contract_employee_own" model="ir.rule">
            <field name="name">Employee own contract read-only</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Salary Contract: HR/Admin has global access -->
        <record id="rule_contract_hr_global" model="ir.rule">
            <field name="name">HR global contracts</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_officer'))]"/>
        </record>
    </data>
</odoo>
