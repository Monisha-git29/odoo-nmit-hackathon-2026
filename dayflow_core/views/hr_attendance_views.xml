<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Attendance Tree/List View -->
    <record id="view_attendance_tree_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit.dayflow</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="daily_status" widget="badge" 
                       decoration-success="daily_status == 'present'"
                       decoration-warning="daily_status == 'half_day'"
                       decoration-danger="daily_status == 'incomplete'"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Attendance Search View to add filters -->
    <record id="hr_attendance_view_filter_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.attendance.filter.inherit.dayflow</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='myattendance']" position="before">
                <filter string="Present Only" name="status_present" domain="[('daily_status', '=', 'present')]"/>
                <filter string="Half Day Only" name="status_half_day" domain="[('daily_status', '=', 'half_day')]"/>
                <filter string="Incomplete (Missing Checkout)" name="status_incomplete" domain="[('daily_status', '=', 'incomplete')]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Daily Status" name="groupby_status" context="{'group_by': 'daily_status'}"/>
            </xpath>
        </field>
    </record>
</odoo>
