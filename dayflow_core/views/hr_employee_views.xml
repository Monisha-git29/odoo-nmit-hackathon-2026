<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Employee Form View -->
    <record id="view_employee_form_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add alert banner on top of the sheet -->
            <xpath expr="//sheet" position="before">
                <field name="has_alerts" invisible="1"/>
                <div class="alert alert-danger" role="alert" style="margin-bottom:10px;" invisible="not has_alerts">
                    <strong>⚠️ Dayflow Attendance Exceptions Alert:</strong>
                    <field name="attendance_alerts_summary" style="white-space: pre-wrap; font-weight: bold; margin-top: 5px; display: block;"/>
                </div>
            </xpath>

            <!-- Add Employee ID next to Name/Title -->
            <xpath expr="//h1" position="before">
                <h2>
                    <field name="employee_id" readonly="1" placeholder="EMP00000"/>
                </h2>
            </xpath>

            <!-- Add work mode and joining date on the main page -->
            <xpath expr="//group[@name='active_group']" position="before">
                <group string="Dayflow HRMS Settings" name="dayflow_settings">
                    <field name="work_mode"/>
                    <field name="joining_date"/>
                    <field name="create_user_checkbox" invisible="id != False"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend Employee Tree View -->
    <record id="view_employee_tree_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="employee_id"/>
            </field>
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="work_mode"/>
                <field name="joining_date"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Company Form View -->
    <record id="view_company_form_inherit_dayflow" model="ir.ui.view">
        <field name="name">res.company.form.inherit.dayflow</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Dayflow HRMS Config" name="dayflow_config">
                    <group>
                        <group string="Geofencing Configurations" name="geofencing_config">
                            <field name="office_latitude"/>
                            <field name="office_longitude"/>
                            <field name="geofence_radius"/>
                        </group>
                        <group string="Working Hour Standard" name="work_hour_config">
                            <field name="standard_work_hours"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
