<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance Pivot View -->
    <record id="view_attendance_pivot_dayflow" model="ir.ui.view">
        <field name="name">hr.attendance.pivot.dayflow</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Analysis" sample="1">
                <field name="employee_id" type="row"/>
                <field name="check_in" interval="day" type="col"/>
                <field name="worked_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Attendance Graph View -->
    <record id="view_attendance_graph_dayflow" model="ir.ui.view">
        <field name="name">hr.attendance.graph.dayflow</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <graph string="Attendance Analysis" type="bar" sample="1">
                <field name="employee_id"/>
                <field name="worked_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Attendance Report Action -->
    <record id="action_attendance_report_dayflow" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_ids" eval="[(5, 0, 0), 
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_attendance_pivot_dayflow')}), 
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_attendance_graph_dayflow')})]"/>
    </record>


    <!-- Leave Pivot View -->
    <record id="view_leave_pivot_dayflow" model="ir.ui.view">
        <field name="name">hr.leave.pivot.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <pivot string="Leave Analysis" sample="1">
                <field name="employee_id" type="row"/>
                <field name="holiday_status_id" type="col"/>
                <field name="number_of_days" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Leave Graph View -->
    <record id="view_leave_graph_dayflow" model="ir.ui.view">
        <field name="name">hr.leave.graph.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <graph string="Leave Analysis" type="bar" sample="1">
                <field name="employee_id"/>
                <field name="number_of_days" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Leave Report Action -->
    <record id="action_leave_report_dayflow" model="ir.actions.act_window">
        <field name="name">Leave Analysis</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_ids" eval="[(5, 0, 0), 
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_leave_pivot_dayflow')}), 
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_leave_graph_dayflow')})]"/>
    </record>


    <!-- Reporting Menus -->
    <menuitem id="menu_dayflow_reporting" name="Reporting" parent="menu_dayflow_root" sequence="10" groups="dayflow_core.group_hr_officer"/>
    
    <menuitem id="menu_dayflow_report_attendance" name="Attendance Analysis" parent="menu_dayflow_reporting" action="action_attendance_report_dayflow" sequence="1"/>
    
    <menuitem id="menu_dayflow_report_leave" name="Leave Analysis" parent="menu_dayflow_reporting" action="action_leave_report_dayflow" sequence="2"/>
</odoo>
