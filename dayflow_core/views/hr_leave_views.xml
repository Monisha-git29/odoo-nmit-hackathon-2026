<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Leave Request Form View -->
    <record id="hr_leave_view_form_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='report_note']" position="after">
                <field name="hr_comment" placeholder="HR review and approval comments..." readonly="state not in ['confirm', 'validate1']"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Leave Manager Form View -->
    <record id="hr_leave_view_form_manager_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.leave.view.form.manager.inherit.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='report_note']" position="after">
                <field name="hr_comment" placeholder="HR review and approval comments..." readonly="state not in ['confirm', 'validate1']"/>
            </xpath>
        </field>
    </record>
</odoo>
