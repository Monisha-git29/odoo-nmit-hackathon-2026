<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_dayflow_attendance_correction_tree" model="ir.ui.view">
        <field name="name">dayflow.attendance.correction.tree</field>
        <field name="model">dayflow.attendance.correction</field>
        <field name="arch" type="xml">
            <tree string="Attendance Corrections">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <field name="issue_type"/>
                <field name="requested_check_in"/>
                <field name="requested_check_out"/>
                <field name="status" widget="badge"
                       decoration-warning="status == 'pending'"
                       decoration-success="status == 'approved'"
                       decoration-danger="status == 'rejected'"/>
                <field name="approved_by" optional="hide"/>
                <field name="approved_at" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dayflow_attendance_correction_form" model="ir.ui.view">
        <field name="name">dayflow.attendance.correction.form</field>
        <field name="model">dayflow.attendance.correction</field>
        <field name="arch" type="xml">
            <form string="Attendance Correction Request">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="status != 'pending'" groups="dayflow_core.group_hr_officer"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="status != 'pending'" groups="dayflow_core.group_hr_officer"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group string="Employee Info">
                            <field name="employee_id" readonly="status != 'pending'"/>
                            <field name="attendance_date" readonly="status != 'pending'"/>
                            <field name="attendance_id" readonly="1" invisible="not attendance_id"/>
                        </group>
                        <group string="Request Details">
                            <field name="issue_type" readonly="status != 'pending'"/>
                            <field name="requested_check_in" readonly="status != 'pending'"/>
                            <field name="requested_check_out" readonly="status != 'pending'"/>
                        </group>
                    </group>
                    <group string="Reason &amp; Remarks">
                        <field name="reason" readonly="status != 'pending'"/>
                        <field name="hr_comment" placeholder="Provide comment or reason for rejection here..." readonly="status != 'pending'"/>
                    </group>
                    <group string="Approval Audit" invisible="status == 'pending'">
                        <group>
                            <field name="approved_by"/>
                        </group>
                        <group>
                            <field name="approved_at"/>
                        </group>
                    </group>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_dayflow_attendance_correction_search" model="ir.ui.view">
        <field name="name">dayflow.attendance.correction.search</field>
        <field name="model">dayflow.attendance.correction</field>
        <field name="arch" type="xml">
            <search string="Search Corrections">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <filter string="Pending" name="filter_pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Approved" name="filter_approved" domain="[('status', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('status', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="groupby_status" context="{'group_by': 'status'}"/>
                    <filter string="Issue Type" name="groupby_issue" context="{'group_by': 'issue_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_dayflow_attendance_correction" model="ir.actions.act_window">
        <field name="name">Attendance Corrections</field>
        <field name="res_model">dayflow.attendance.correction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_dayflow_attendance_correction_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance correction requests found.
            </p>
        </field>
    </record>

    <!-- Submenu -->
    <menuitem id="menu_dayflow_attendance_correction" name="Corrections" parent="menu_dayflow_root" action="action_dayflow_attendance_correction" sequence="3"/>
</odoo>
